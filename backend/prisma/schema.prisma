// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now())

  // Relations
  hostedRooms  Room[]            @relation("HostedRooms")
  participants RoomParticipant[]

  @@map("users")
}

model Room {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  hostId      String
  status      String    @default("waiting") // waiting, live, ended
  maxSpeakers Int       @default(10)
  isPublic    Boolean   @default(true)
  egressId    String?   // LiveKit egress ID for recording
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  endedAt     DateTime?

  // Relations
  host         User              @relation("HostedRooms", fields: [hostId], references: [id])
  participants RoomParticipant[]
  recordings   Recording[]

  @@map("rooms")
}

model RoomParticipant {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  role     String // host, speaker, listener
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_participants")
}

model Recording {
  id             String   @id @default(uuid())
  roomId         String
  fileUrl        String
  durationSeconds Int?
  fileSizeBytes  BigInt?
  format         String   @default("mp3")
  createdAt      DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("recordings")
}
